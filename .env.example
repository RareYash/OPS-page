# App
APP_ENV=development
DEBUG=false
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql://newtonite:newtonite_dev_pass@db:5432/newtonite
POSTGRES_USER=newtonite
POSTGRES_PASSWORD=newtonite_dev_pass
POSTGRES_DB=newtonite

# Session
SESSION_EXPIRE_HOURS=8

# Worker
WORKER_POLL_INTERVAL=2
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=6
WORKER_STUCK_TIMEOUT_SECONDS=60

# Rate limiting
LOGIN_RATE_LIMIT_PER_MINUTE=10
